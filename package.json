{
  "name": "@huseynsnmz/pi-modes",
  "version": "0.4.0",
  "description": "Shift+Tab permission modes for Pi: normal, auto, plan, read-only and yolo",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "permissions",
    "plan-mode"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huseynsnmz/pi-modes.git"
  },
  "files": [
    "src",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts test/*.test.mjs",
    "e2e:solo": "python3 test/e2e/run.py solo",
    "e2e": "python3 test/e2e/run.py modes-first && python3 test/e2e/run.py modes-last && python3 test/e2e/run.py classifier-last"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@types/node": "26.6.6",
    "typebox": "1.4.3",
    "typescript": "7.0.2"
  }
}
