{
	"name": "@huseynsnmz/pi-frame",
	"version": "0.2.0",
	"description": "Pi's start screen, a framed editor, a box around every tool call and a session footer. A hardened fork of @adeildo/pi-look.",
	"keywords": [
		"pi",
		"pi-coding-agent",
		"pi-extension",
		"pi-package",
		"statusline",
		"theme",
		"tui"
	],
	"homepage": "https://github.com/huseynsnmz/pi-frame#readme",
	"bugs": "https://github.com/huseynsnmz/pi-frame/issues",
	"license": "MIT",
	"author": {
		"name": "Hüseyin Sönmez",
		"email": "huseyin@snmz.org",
		"url": "https://github.com/huseynsnmz"
	},
	"contributors": [
		{
			"name": "adeildo",
			"url": "https://github.com/felipeadeildo"
		}
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/huseynsnmz/pi-frame.git"
	},
	"files": [
		"src",
		"docs",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"check": "tsc --noEmit",
		"test": "bun test",
		"e2e": "python3 test/e2e/run.py"
	},
	"dependencies": {
		"@adeildo/pi-kit": "6.0.0",
		"diff": "8.0.4"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "1.5.0",
		"@earendil-works/pi-coding-agent": "1.5.0",
		"@earendil-works/pi-tui": "1.5.0",
		"@types/bun": "1.3.1",
		"@types/node": "24.13.3",
		"typebox": "1.3.27",
		"typescript": "6.0.3"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	}
}
